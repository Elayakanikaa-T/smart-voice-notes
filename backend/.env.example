# ==============================================================================
# SMART VOICE NOTE APPLICATION — ENVIRONMENT CONFIGURATION
# ==============================================================================

# Server
NODE_ENV=development
PORT=5000
API_PREFIX=/api/v1
CORS_ORIGIN=*

# Authentication
JWT_ACCESS_SECRET=super_secret_access_key_change_in_production_min_32_chars!
JWT_REFRESH_SECRET=super_secret_refresh_key_change_in_production_min_32_chars!
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# PostgreSQL Configuration
PG_HOST=localhost
PG_PORT=5432
PG_USER=postgres
PG_PASSWORD=postgres
PG_DATABASE=smart_voice_notes
PG_SSL=false

# MongoDB Configuration
MONGODB_URI=mongodb://localhost:27017/smart_voice_notes

# Redis Configuration (BullMQ Queues)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Storage (AWS S3 or Local Mock Adapter)
STORAGE_DRIVER=local # 's3' or 'local'
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test_access_key
AWS_SECRET_ACCESS_KEY=test_secret_key
S3_BUCKET_NAME=smart-voice-notes-audio
S3_SIGNED_URL_EXPIRY=3600 # 1 hour
LOCAL_UPLOAD_DIR=./uploads

# AI Providers Config
STT_PROVIDER=mock # 'whisper' | 'assemblyai' | 'google' | 'mock'
OPENAI_API_KEY=sk-demo-openai-key
ASSEMBLYAI_API_KEY=demo-assembly-key
GOOGLE_APPLICATION_CREDENTIALS=./google-creds.json

LLM_PROVIDER=mock # 'openai' | 'gemini' | 'anthropic' | 'mock'
GEMINI_API_KEY=demo-gemini-key
ANTHROPIC_API_KEY=demo-anthropic-key

# n8n Automation Webhook URLs
N8N_EXAM_REMINDERS_WEBHOOK_URL=http://localhost:5678/webhook/exam-reminder
N8N_NOTE_PIPELINE_WEBHOOK_URL=http://localhost:5678/webhook/note-pipeline
N8N_CALENDAR_SYNC_WEBHOOK_URL=http://localhost:5678/webhook/calendar-sync
N8N_AUTO_SHARE_WEBHOOK_URL=http://localhost:5678/webhook/auto-share
N8N_WEBHOOK_SECRET=n8n_secret_hmac_token_123

# Email Notifications (Optional - for Action Item Due / Overdue alerts)
EMAIL_HOST=smtp.mailtrap.io
EMAIL_PORT=2525
EMAIL_SECURE=false
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=no-reply@meetingportal.internal
